[Desktop Entry]
Type=Application
Name=Uninstall Steam Controller GyroDSU
Comment=Remove the gyro DSU server for the 2026 Steam Controller
Icon=input-gaming
Terminal=true
Exec=bash -c "curl -fsSL https://raw.githubusercontent.com/ScarletPachydermDev/SteamControllerGyroDSU/master/uninstall.sh | bash; echo; read -n 1 -s -r -p 'Press any key to close.'"
Categories=Game;
